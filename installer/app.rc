// Icon 1 is what Windows (and SDL, see main.cpp) uses for the exe, taskbar and window.
1 ICON "capsule.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Capsule"
      VALUE "ProductName", "Capsule"
      VALUE "ProductVersion", "1.0.0"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "capsule.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
